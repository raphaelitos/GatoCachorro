<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TelaFrasesActivity">


    <View
        android:id="@+id/view_imgs"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:padding="12dp"
        android:background="@color/background_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/img_cat"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/cat_svgrepo_com"
        app:tint="@color/white"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/view_imgs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/img_dog"/>

    <ImageView
        android:id="@+id/img_dog"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/dog_svgrepo_com"
        app:tint="@color/white"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/view_imgs"
        app:layout_constraintEnd_toStartOf="@id/img_crow"
        app:layout_constraintStart_toEndOf="@id/img_cat"
         />

    <ImageView
        android:id="@+id/img_crow"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/crow_svgrepo_com"
        app:tint="@color/white"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/view_imgs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/img_dog"
        />

    <Button
        android:id="@+id/btn_voltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/material_dynamic_primary60"
        android:text="@string/txt_btn_voltar"

        app:layout_constraintTop_toBottomOf="@id/view_imgs"
        app:layout_constraintBottom_toTopOf="@id/txt_saudacao_app_page"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="8dp"
        />

    <TextView
        android:id="@+id/txt_saudacao_app_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/txt_saudacao_app_page"
        android:layout_marginStart="16dp"

        app:layout_constraintTop_toBottomOf="@id/view_imgs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/nome_app_page"
        app:layout_constraintBottom_toTopOf="@id/txt_curiosity"
        app:layout_constraintHorizontal_chainStyle="packed"

        />

    <TextView
        android:id="@+id/nome_app_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/txt_nome_user_app_page"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"

        app:layout_constraintTop_toBottomOf="@id/view_imgs"
        app:layout_constraintStart_toEndOf="@id/txt_saudacao_app_page"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txt_curiosity"
        />

    <TextView
        android:id="@+id/txt_curiosity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/txt_curiosidade"
        android:gravity="center"
        android:layout_marginHorizontal="8dp"
        android:clickable="true"
        android:textSize="16dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_calc_app_page"
        app:layout_constraintTop_toBottomOf="@+id/txt_saudacao_app_page"
        />

    <Button
        android:id="@+id/btn_calc_app_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/txt_btn_calc_app_page"
        android:backgroundTint="@color/material_dynamic_primary60"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_curiosity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>